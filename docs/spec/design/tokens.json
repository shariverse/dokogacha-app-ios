{
  "$description": "ドコガチャ デザイントークン。04_design_system.md と同じ値。",
  "color": {
    "bg": { "base": "#FFF7EE" },
    "surface": {
      "card": "#FFFFFF",
      "highlight": "#FFF1C9",
      "subtle": "#FFF7EE",
      "muted": "#F1E4D6",
      "disabled": "#E6D9CB",
      "ad": "#FBF1E6",
      "gachaDome": "#FFFDF9"
    },
    "ink": "#2B2118",
    "text": {
      "primary": "#2B2118",
      "secondary": "#6E5E50",
      "disabled": "#5E5045",
      "onInk": "#F3E3CF",
      "onAccent": "#FFFFFF"
    },
    "line": { "dashed": "#E3D3C2", "dashedStrong": "#CDB9A4" },
    "accent": {
      "primary": "#D93A1F",
      "text": "#B8321A",
      "secondary": "#FFC93C",
      "pale": "#FFF0C2",
      "paleText": "#5C4600"
    },
    "like": { "bg": "#F7EEE4", "bgActive": "#FDE3DC", "icon": "#5E5045", "iconActive": "#B8321A", "iconMine": "#9C8B7C" },
    "status": {
      "open": { "bg": "#E3F2EC", "fg": "#1E5E49" },
      "unlocked": { "bg": "#FFC93C", "fg": "#2B2118" },
      "drawn": { "bg": "#2B2118", "fg": "#FFC93C" },
      "closed": { "bg": "#F1E4D6", "fg": "#5E5045" }
    },
    "level": {
      "high": { "label": "出やすい", "chipBg": "#D93A1F", "chipFg": "#FFFFFF", "bar": "#D93A1F", "number": "#B8321A" },
      "mid": { "label": "ふつう", "chipBg": "#FFC93C", "chipFg": "#2B2118", "bar": "#FFC93C", "number": "#2B2118" },
      "low": { "label": "レア", "chipBg": "#DCEBFF", "chipFg": "#1D5A99", "bar": "#4DA3FF", "number": "#1D5A99" },
      "flat": { "label": "平等", "chipBg": "#F1E4D6", "chipFg": "#2B2118", "bar": "#CDB9A4", "number": "#2B2118" }
    },
    "capsule": ["#FF7A59", "#FFC93C", "#3CC9A0", "#4DA3FF", "#FF8FC7", "#9B7BFF"],
    "avatar": ["#B8321A", "#23775D", "#2F6FD0", "#A3367E", "#6B48C9", "#8A5A12", "#1F6E8C", "#5E5045"],
    "avatarNotReady": { "bg": "#F1E7DC", "fg": "#5E5045" },
    "category": {
      "aquarium": { "label": "水族館", "bg": "#D6ECFF", "fg": "#1D5A99", "icon": "cat-aquarium" },
      "nature": { "label": "自然", "bg": "#DDF3E6", "fg": "#1E6B47", "icon": "cat-nature" },
      "art": { "label": "アート・美術館", "bg": "#F1E3FF", "fg": "#6B3FA0", "icon": "cat-art" },
      "food": { "label": "グルメ", "bg": "#FFE4D6", "fg": "#A23B12", "icon": "cat-food" },
      "activity": { "label": "アクティビティ", "bg": "#D9F4F1", "fg": "#146B63", "icon": "cat-activity" },
      "park": { "label": "テーマパーク", "bg": "#FFE1EE", "fg": "#A02A62", "icon": "cat-park" },
      "town": { "label": "街歩き", "bg": "#FFF0C2", "fg": "#7A5A00", "icon": "cat-town" },
      "shrine": { "label": "寺社", "bg": "#FFDCD6", "fg": "#A12A1A", "icon": "cat-shrine" },
      "sea": { "label": "海", "bg": "#D6F0FF", "fg": "#165E8C", "icon": "cat-sea" }
    }
  },
  "font": {
    "display": { "family": "Mochiy Pop One", "postScript": { "regular": "MochiyPopOne-Regular" }, "license": "OFL-1.1" },
    "body": {
      "family": "Zen Maru Gothic",
      "postScript": { "regular": "ZenMaruGothic-Regular", "medium": "ZenMaruGothic-Medium", "bold": "ZenMaruGothic-Bold", "black": "ZenMaruGothic-Black" },
      "license": "OFL-1.1"
    }
  },
  "typeScale": {
    "display.xl": { "font": "display", "size": 32, "relativeTo": "largeTitle" },
    "display.ticket": { "font": "display", "size": 27, "relativeTo": "title" },
    "display.l": { "font": "display", "size": 24, "relativeTo": "title2" },
    "display.m": { "font": "display", "size": 22, "relativeTo": "title2" },
    "display.s": { "font": "display", "size": 20, "relativeTo": "title3" },
    "display.header": { "font": "display", "size": 18, "relativeTo": "headline" },
    "display.section": { "font": "display", "size": 17, "relativeTo": "headline" },
    "display.tag": { "font": "display", "size": 12, "relativeTo": "caption" },
    "body.title": { "font": "body", "weight": "black", "size": 16, "relativeTo": "body" },
    "body.button": { "font": "body", "weight": "black", "size": 17, "relativeTo": "body" },
    "body.regular": { "font": "body", "weight": "regular", "size": 14, "relativeTo": "subheadline" },
    "body.caption": { "font": "body", "weight": "regular", "size": 12, "relativeTo": "caption" }
  },
  "radius": { "xs": 6, "s": 12, "m": 16, "l": 20, "pill": 999 },
  "border": { "regular": 2, "strong": 2.5, "machine": 5 },
  "shadow": { "hard": { "x": 0, "y": 4, "blur": 0, "color": "#2B2118" }, "hardSmall": { "x": 0, "y": 3, "blur": 0, "color": "#2B2118" } },
  "spacing": { "screenX": 16, "cardPadding": 14, "scale": [4, 6, 8, 10, 12, 14, 16, 22, 24] },
  "minTapTarget": 44,
  "motion": {
    "shake": { "duration": 0.4, "repeat": 4, "curve": "easeInOut" },
    "turn": { "duration": 1.6, "curve": [0.4, 0, 0.2, 1] },
    "drop": { "duration": 0.7, "curve": "easeOut" },
    "open": { "duration": 0.5, "curve": "easeIn" },
    "pop": { "duration": 0.45, "curve": [0.2, 0.9, 0.3, 1.3] },
    "stamp": { "duration": 0.5, "delay": 0.5 },
    "meter": { "duration": 0.35, "curve": "easeOut" },
    "toast": { "duration": 0.25, "visibleFor": 2.2 }
  }
}
