# Trigger Email 拡張（firebase/firestore-send-email。firebase.json の extensions）の設定（Discussion #5 の Q7）。
# reportCandidate（functions/src/reports/）が mail コレクションに書いた運営向けのメールを、SMTP で送る。
#
# このファイルには、どのプロジェクトでも同じで秘密でない値だけを書く（public リポジトリ）。
# 次の値は人間が用意し、extensions/firestore-send-email.env.<プロジェクト ID>（git の管理外。.gitignore）に書く:
#   SMTP_CONNECTION_URI  SMTP の接続先（例の形: smtps://<ユーザー名>@<ホスト>:465。パスワードは入れない）
#   DEFAULT_FROM         送り主のアドレス
# SMTP のパスワードは Cloud Secret Manager に置き、ここでは参照だけを書く（値はリポジトリにもこのファイルにも書かない）。
# 宛先（運営のアドレス）は拡張ではなく Functions のパラメータ REPORT_MAIL_TO（functions/src/reports/functions.ts）。
# Emulator では拡張を動かさない（scripts/emulator-config.cjs の withoutExtensions）。
AUTH_TYPE=UsernamePassword
DATABASE=(default)
DATABASE_REGION=asia-northeast1
MAIL_COLLECTION=mail
SMTP_PASSWORD=projects/${param:PROJECT_NUMBER}/secrets/firestore-send-email-SMTP_PASSWORD/versions/latest
TTL_EXPIRE_TYPE=never
TTL_EXPIRE_VALUE=1
