//
//  Stg.xcconfig
//  Dokogacha
//
//  Stg 構成だけに適用したい設定をここに書く。
//  Stg は TestFlight 用（develop の Upload）の構成で、Release と同じ最適化でビルドし、Firebase は dev に接続する。
//  App Store に出す Release は常に prod に接続する（Discussion #5 の Q4）。
//

#include "Project.xcconfig"

// アプリの Bundle ID。Stg は App Store Connect で本番（Project.xcconfig の jp.shilokuma.Dokogacha）とは別のアプリにする（Issue #189）。
// TestFlight で本番のビルドと混ざらず、同じ端末に並べて入れられる。ホーム画面の名前は本番と同じで、アイコン（DG_APP_ICON_NAME）で見分ける。
// Universal Links の apple-app-site-association にも並べる。App Store の掲載情報のツール（Tools/app_store_config.py）は Project.xcconfig の本番の値を読む
APP_BUNDLE_IDENTIFIER = jp.shilokuma.Dokogacha.stg
// Firebase の接続先（Info.plist の DGFirebaseEnvironment）。Stg は dev プロジェクト
DG_FIREBASE_ENVIRONMENT = dev
// 読む GoogleService-Info の名前（拡張子なし）。CI が Dokogacha/Resources/Firebase/GoogleService-Info-Dev.plist に書き出す
DG_FIREBASE_OPTIONS_FILE_NAME = GoogleService-Info-Dev
// prod の plist が手元にあっても、TestFlight 用のアプリには入れない
EXCLUDED_SOURCE_FILE_NAMES = $(inherited) GoogleService-Info-Prod.plist
// APNs の環境（Configs/Dokogacha.entitlements の aps-environment）。TestFlight は App Store の配布用の署名なので production
DG_APS_ENVIRONMENT = production
// Analytics・Crashlytics の収集の既定（Info.plist の FIREBASE_ANALYTICS_COLLECTION_ENABLED・FirebaseCrashlyticsCollectionEnabled）。
// TestFlight のアプリは dev に送る（起動ごとの判定は FirebaseCollectionPolicy）
DG_FIREBASE_COLLECTION_ENABLED = YES
// アプリアイコン（Dokogacha/Assets.xcassets の <名前>.appiconset）。Stg（TestFlight）は下端に「STG」の帯を付けたもの（Tools/render_app_icon.sh）
DG_APP_ICON_NAME = AppIcon-Stg
