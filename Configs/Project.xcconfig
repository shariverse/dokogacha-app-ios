//
//  Project.xcconfig
//  Dokogacha
//
//  プロジェクト共通のビルド設定。
//  テンプレートから新規リポジトリを作成したら、まずこのファイルの値を書き換える。
//  （pbxproj 側にはこれらの値を直接書かず、ここだけを編集する）
//

// Apple Developer Program の Team ID
DEVELOPMENT_TEAM = XU74X3434S

// アプリ本体の Bundle Identifier。
// テストターゲットは $(APP_BUNDLE_IDENTIFIER).Tests / .UITests として派生させる
APP_BUNDLE_IDENTIFIER = jp.shilokuma.Dokogacha

// バージョン（CFBundleShortVersionString / CFBundleVersion）
MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1

// 最低サポート OS
IPHONEOS_DEPLOYMENT_TARGET = 17.0

// Firebase（Analytics など）と Google Mobile Ads を SPM で入れるときに必要（各 SDK の導入手順）。
// -ObjC で Google Mobile Ads のすべてのオブジェクトを読み込むため、コードで import していない間も
// JavaScriptCore が要る（モジュールの link 指定は import したときにしか効かない）
OTHER_LDFLAGS = $(inherited) -ObjC -framework JavaScriptCore
