//
//  Debug.xcconfig
//  Dokogacha
//
//  Debug 構成だけに適用したい設定をここに書く。
//

#include "Project.xcconfig"

// アプリの Bundle ID。Debug は本番（Project.xcconfig の jp.shilokuma.Dokogacha）に .dev を付けた別のアプリにする（Issue #210）。
// Xcode から実機に入れても TestFlight の本番・Stg のアプリを上書きせず、同じ端末に並べて入れられる。アイコンの「DEV」の帯で見分ける。
// App ID は Xcode の自動署名が作る。Emulator の購入の検証（backend/functions/.env.demo-dokogacha の APP_STORE_BUNDLE_ID）もこの値にする。
// 実機の Debug は Emulator（localhost）に繋がらないので、招待リンクの AASA には並べない
APP_BUNDLE_IDENTIFIER = jp.shilokuma.Dokogacha.dev
// Firebase の接続先（Info.plist の DGFirebaseEnvironment。値は FirebaseEnvironment の rawValue）。
// Debug は Emulator の demo プロジェクト（demo-dokogacha）に、コードで作った FirebaseOptions で接続するので plist を読まない
DG_FIREBASE_ENVIRONMENT = emulator
// 読む GoogleService-Info の名前（拡張子なし。Info.plist の DGFirebaseOptionsFileName）。Debug は使わないので空
DG_FIREBASE_OPTIONS_FILE_NAME =
// Dokogacha/Resources/Firebase/ に置いた plist は、どれもこの構成のアプリに入れない
EXCLUDED_SOURCE_FILE_NAMES = $(inherited) GoogleService-Info-Dev.plist GoogleService-Info-Prod.plist
// APNs の環境（Configs/Dokogacha.entitlements の aps-environment）。Xcode から実機に入れる開発用の署名は development
DG_APS_ENVIRONMENT = development
// Analytics・Crashlytics の収集の既定（Info.plist の FIREBASE_ANALYTICS_COLLECTION_ENABLED・FirebaseCrashlyticsCollectionEnabled）。
// Debug は Emulator に繋ぐ開発用なので送らない（起動ごとの判定は FirebaseCollectionPolicy）
DG_FIREBASE_COLLECTION_ENABLED = NO
// アプリアイコン（Dokogacha/Assets.xcassets の <名前>.appiconset）。Debug は下端に「DEV」の帯を付けたもの（Tools/render_app_icon.sh）
DG_APP_ICON_NAME = AppIcon-Debug
